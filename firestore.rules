rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'webhookUrl', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('webhookUrl' in data) || (data.webhookUrl is string && data.webhookUrl.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClientLead(data, userId, leadId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'companyName', 'contactName', 'email', 'phone', 'region',
        'serviceTrack', 'requirement', 'priorityTag', 'status', 'dispatchedChannels',
        'whatsappPreview', 'emailSubject', 'emailBody', 'createdAtLabel', 'webhookSynced',
        'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'companyName', 'contactName', 'email', 'phone', 'region',
          'serviceTrack', 'requirement', 'priorityTag', 'status', 'dispatchedChannels',
          'whatsappPreview', 'emailSubject', 'emailBody', 'createdAtLabel', 'webhookSynced',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == leadId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160
        && data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 180
        && data.phone is string && data.phone.size() >= 4 && data.phone.size() <= 40
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 100
        && data.serviceTrack in ['HR & Manpower Hiring', 'AI Business Automation']
        && data.requirement is string && data.requirement.size() >= 1 && data.requirement.size() <= 1000
        && data.priorityTag in ['Priority #1 VIP']
        && data.status in ['Instant Proposal Sent', 'AI Screening Scheduled', 'Discovery Call Booked']
        && data.dispatchedChannels is string && data.dispatchedChannels.size() >= 1 && data.dispatchedChannels.size() <= 80
        && data.whatsappPreview is string && data.whatsappPreview.size() >= 1 && data.whatsappPreview.size() <= 1500
        && data.emailSubject is string && data.emailSubject.size() >= 1 && data.emailSubject.size() <= 240
        && data.emailBody is string && data.emailBody.size() >= 1 && data.emailBody.size() <= 3000
        && data.createdAtLabel is string && data.createdAtLabel.size() >= 1 && data.createdAtLabel.size() <= 60
        && data.webhookSynced is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidKeywordRank(data, userId, keywordId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'keyword', 'category', 'rank', 'previousRank',
        'monthlyVolume', 'targetUrl', 'intent', 'lastUpdated', 'createdAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'keyword', 'category', 'rank', 'previousRank',
          'monthlyVolume', 'targetUrl', 'intent', 'lastUpdated', 'createdAt'
        ])
        && data.id is string && data.id == keywordId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.keyword is string && data.keyword.size() >= 1 && data.keyword.size() <= 200
        && data.category in ['HR Staffing', 'AI Automation', 'Compliance']
        && data.rank is int && data.rank >= 1 && data.rank <= 100
        && data.previousRank is int && data.previousRank >= 1 && data.previousRank <= 200
        && data.monthlyVolume is int && data.monthlyVolume >= 0 && data.monthlyVolume <= 10000000
        && data.targetUrl is string && data.targetUrl.size() >= 1 && data.targetUrl.size() <= 240
        && data.intent in ['High Commercial', 'Transactional', 'Local B2B']
        && data.lastUpdated is string && data.lastUpdated.size() >= 1 && data.lastUpdated.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidSeoPackage(data, userId, seoId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'serviceName', 'targetLocation', 'category',
        'pageTitle', 'metaDescription', 'lsiKeywords', 'urlSlug',
        'schemaJsonLd', 'createdAtLabel', 'createdAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'serviceName', 'targetLocation', 'category',
          'pageTitle', 'metaDescription', 'lsiKeywords', 'urlSlug',
          'schemaJsonLd', 'createdAtLabel', 'createdAt'
        ])
        && data.id is string && data.id == seoId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.serviceName is string && data.serviceName.size() >= 1 && data.serviceName.size() <= 160
        && data.targetLocation is string && data.targetLocation.size() >= 1 && data.targetLocation.size() <= 120
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 120
        && data.pageTitle is string && data.pageTitle.size() >= 1 && data.pageTitle.size() <= 80
        && data.metaDescription is string && data.metaDescription.size() >= 1 && data.metaDescription.size() <= 200
        && data.lsiKeywords is list && data.lsiKeywords.size() >= 1 && data.lsiKeywords.size() <= 15
        && data.lsiKeywords[0] is string && data.lsiKeywords[0].size() <= 120
        && data.urlSlug is string && data.urlSlug.size() >= 1 && data.urlSlug.size() <= 200
        && data.schemaJsonLd is string && data.schemaJsonLd.size() >= 2 && data.schemaJsonLd.size() <= 6000
        && data.createdAtLabel is string && data.createdAtLabel.size() >= 1 && data.createdAtLabel.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidChecklistItem(data, userId, itemId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'title', 'description', 'category',
        'region', 'cadence', 'impact', 'completed', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'description', 'category',
          'region', 'cadence', 'impact', 'completed', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == itemId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && data.category in ['Google Business Profile', 'Local & PAN India Directories', 'Automated Blog & Backlinks']
        && data.region is string && data.region.size() >= 1 && data.region.size() <= 100
        && data.cadence is string && data.cadence.size() >= 1 && data.cadence.size() <= 60
        && data.impact in ['High', 'Medium']
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSeoAuditMeta(data) {
      return data.metaStatus in ['Pass', 'Warning', 'Critical']
        && data.metaTitle is string && data.metaTitle.size() <= 300
        && data.metaTitleLength is int && data.metaTitleLength >= 0 && data.metaTitleLength <= 500
        && data.metaDescription is string && data.metaDescription.size() <= 600
        && data.metaDescriptionLength is int && data.metaDescriptionLength >= 0 && data.metaDescriptionLength <= 1000
        && data.canonical is string && data.canonical.size() <= 500
        && data.robots is string && data.robots.size() <= 120
        && data.viewport is string && data.viewport.size() <= 200
        && data.ogTitle is string && data.ogTitle.size() <= 300
        && data.ogDescription is string && data.ogDescription.size() <= 600
        && data.ogImage is string && data.ogImage.size() <= 500
        && data.twitterCard is string && data.twitterCard.size() <= 120;
    }

    function isValidSeoAuditHeadingsImages(data) {
      return data.headingsStatus in ['Pass', 'Warning', 'Critical']
        && data.headingsTotalCount is int && data.headingsTotalCount >= 0 && data.headingsTotalCount <= 5000
        && data.h1Count is int && data.h1Count >= 0 && data.h1Count <= 1000
        && data.h2Count is int && data.h2Count >= 0 && data.h2Count <= 1000
        && data.h3Count is int && data.h3Count >= 0 && data.h3Count <= 1000
        && data.h4Count is int && data.h4Count >= 0 && data.h4Count <= 1000
        && data.h5Count is int && data.h5Count >= 0 && data.h5Count <= 1000
        && data.h6Count is int && data.h6Count >= 0 && data.h6Count <= 1000
        && data.skippedTransitions is list && data.skippedTransitions.size() >= 1 && data.skippedTransitions.size() <= 20
        && data.skippedTransitions[0] is string && data.skippedTransitions[0].size() <= 160
        && data.headingNodesEncoded is list && data.headingNodesEncoded.size() >= 1 && data.headingNodesEncoded.size() <= 30
        && data.headingNodesEncoded[0] is string && data.headingNodesEncoded[0].size() <= 300
        && data.imagesStatus in ['Pass', 'Warning', 'Critical']
        && data.imagesTotalCount is int && data.imagesTotalCount >= 0 && data.imagesTotalCount <= 5000
        && data.withAltCount is int && data.withAltCount >= 0 && data.withAltCount <= 5000
        && data.emptyAltCount is int && data.emptyAltCount >= 0 && data.emptyAltCount <= 5000
        && data.missingAltCount is int && data.missingAltCount >= 0 && data.missingAltCount <= 5000
        && data.imageItemsEncoded is list && data.imageItemsEncoded.size() >= 1 && data.imageItemsEncoded.size() <= 25
        && data.imageItemsEncoded[0] is string && data.imageItemsEncoded[0].size() <= 600;
    }

    function isValidSeoAudit(data, userId, auditId) {
      return data.keys().hasAll([
        'id', 'ownerId', 'url', 'finalUrl', 'httpStatus', 'responseTimeMs',
        'auditedAtLabel', 'passedChecks', 'totalChecks', 'metaStatus',
        'metaTitle', 'metaTitleLength', 'metaDescription', 'metaDescriptionLength',
        'canonical', 'robots', 'viewport', 'ogTitle', 'ogDescription',
        'ogImage', 'twitterCard', 'headingsStatus', 'headingsTotalCount',
        'h1Count', 'h2Count', 'h3Count', 'h4Count', 'h5Count', 'h6Count',
        'skippedTransitions', 'headingNodesEncoded', 'imagesStatus',
        'imagesTotalCount', 'withAltCount', 'emptyAltCount', 'missingAltCount',
        'imageItemsEncoded', 'recommendations', 'createdAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerId', 'url', 'finalUrl', 'httpStatus', 'responseTimeMs',
          'auditedAtLabel', 'passedChecks', 'totalChecks', 'metaStatus',
          'metaTitle', 'metaTitleLength', 'metaDescription', 'metaDescriptionLength',
          'canonical', 'robots', 'viewport', 'ogTitle', 'ogDescription',
          'ogImage', 'twitterCard', 'headingsStatus', 'headingsTotalCount',
          'h1Count', 'h2Count', 'h3Count', 'h4Count', 'h5Count', 'h6Count',
          'skippedTransitions', 'headingNodesEncoded', 'imagesStatus',
          'imagesTotalCount', 'withAltCount', 'emptyAltCount', 'missingAltCount',
          'imageItemsEncoded', 'recommendations', 'createdAt'
        ])
        && data.id is string && data.id == auditId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId
        && data.url is string && data.url.size() >= 1 && data.url.size() <= 500
        && data.finalUrl is string && data.finalUrl.size() >= 1 && data.finalUrl.size() <= 500
        && data.httpStatus is int && data.httpStatus >= 100 && data.httpStatus <= 599
        && data.responseTimeMs is int && data.responseTimeMs >= 0 && data.responseTimeMs <= 120000
        && data.auditedAtLabel is string && data.auditedAtLabel.size() >= 1 && data.auditedAtLabel.size() <= 60
        && data.passedChecks is int && data.passedChecks >= 0 && data.passedChecks <= 50
        && data.totalChecks is int && data.totalChecks >= 1 && data.totalChecks <= 50
        && data.recommendations is list && data.recommendations.size() >= 1 && data.recommendations.size() <= 20
        && data.recommendations[0] is string && data.recommendations[0].size() <= 300
        && data.createdAt is timestamp
        && isValidSeoAuditMeta(data)
        && isValidSeoAuditHeadingsImages(data);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'webhookUrl', 'updatedAt']);
      allow delete: if false;

      match /leads/{leadId} {
        allow get: if isOwner(userId) && isValidId(leadId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(leadId)
          && isValidClientLead(incoming(), userId, leadId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(leadId)
          && isValidClientLead(incoming(), userId, leadId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'webhookSynced', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(leadId);
      }

      match /keywords/{keywordId} {
        allow get: if isOwner(userId) && isValidId(keywordId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(keywordId)
          && isValidKeywordRank(incoming(), userId, keywordId)
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(keywordId)
          && isValidKeywordRank(incoming(), userId, keywordId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['rank', 'previousRank', 'lastUpdated']);
        allow delete: if isOwner(userId) && isValidId(keywordId);
      }

      match /seoPackages/{seoId} {
        allow get: if isOwner(userId) && isValidId(seoId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(seoId)
          && isValidSeoPackage(incoming(), userId, seoId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(seoId);
      }

      match /checklist/{itemId} {
        allow get: if isOwner(userId) && isValidId(itemId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(itemId)
          && isValidChecklistItem(incoming(), userId, itemId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId) && isValidId(itemId)
          && isValidChecklistItem(incoming(), userId, itemId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(itemId);
      }

      match /seoAudits/{auditId} {
        allow get: if isOwner(userId) && isValidId(auditId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isOwner(userId) && isValidId(auditId)
          && isValidSeoAudit(incoming(), userId, auditId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(auditId);
      }
    }
  }
}
